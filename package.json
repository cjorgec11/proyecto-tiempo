{
  "name": "ridecast",
  "version": "1.0.0",
  "private": true,
  "description": "Tiempo de ruta para ciclistas",
  "author": "Jorge",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "start": "node server.mjs",
    "build": "node scripts/build.mjs",
    "build:mobile": "node scripts/build-mobile.mjs",
    "prepare:release": "node scripts/prepare-release.mjs",
    "setup:admin": "node scripts/setup-admin.mjs",
    "test": "node --test tests/*.test.mjs",
    "electron": "electron .",
    "build:win": "electron-builder --win --x64",
    "cap:sync": "npm run build:mobile && cap sync android",
    "cap:build:apk": "npm run cap:sync && cd android && gradlew.bat assembleDebug"
  },
  "build": {
    "appId": "com.jorge.ridecast",
    "productName": "RideCast",
    "files": [
      "electron/**/*",
      "js/**/*",
      "app.js",
      "index.html",
      "workspace.css",
      "vendor/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.2",
    "@capacitor/cli": "^8.3.2",
    "@capacitor/core": "^8.3.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "jsdom": "26.1.0"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "lucide": "0.468.0"
  }
}
