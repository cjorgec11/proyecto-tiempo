{
  "name": "ridecast",
  "version": "1.0.0",
  "private": true,
  "description": "Tiempo de ruta para ciclistas",
  "author": "Jorge",
  "main": "electron/principal.cjs",
  "type": "module",
  "scripts": {
    "clean": "node herramientas/limpiar.mjs",
    "start": "node servidor.mjs",
    "build": "node herramientas/compilar.mjs",
    "build:mobile": "node herramientas/compilar-movil.mjs",
    "prepare:release": "node herramientas/preparar-publicacion.mjs",
    "setup:admin": "node herramientas/configurar-administracion.mjs",
    "test": "node --test pruebas/*.test.mjs",
    "electron": "electron .",
    "build:win": "electron-builder --win --x64",
    "cap:sync": "npm run build:mobile && cap sync android",
    "cap:build:apk": "npm run cap:sync && cd android && gradlew.bat assembleDebug",
    "iniciar": "node servidor.mjs",
    "limpiar": "node herramientas/limpiar.mjs",
    "compilar": "node herramientas/compilar.mjs",
    "compilar:movil": "node herramientas/compilar-movil.mjs",
    "preparar:publicacion": "node herramientas/preparar-publicacion.mjs",
    "configurar:administracion": "node herramientas/configurar-administracion.mjs",
    "probar": "node --test pruebas/*.test.mjs",
    "escritorio": "electron .",
    "compilar:windows": "electron-builder --win --x64",
    "sincronizar:android": "npm run compilar:movil && cap sync android",
    "compilar:apk": "npm run sincronizar:android && cd android && gradlew.bat assembleDebug"
  },
  "build": {
    "appId": "com.jorge.ridecast",
    "productName": "RideCast",
    "files": [
      "electron/**/*",
      "cliente/**/*",
      "aplicacion.js",
      "index.html",
      "interfaz.css",
      "vendor/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.2",
    "@capacitor/cli": "^8.3.2",
    "@capacitor/core": "^8.3.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "jsdom": "26.1.0"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "lucide": "0.468.0"
  }
}
