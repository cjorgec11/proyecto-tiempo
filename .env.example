# Private server-side value in Sites. Generate locally with scripts/setup-admin.mjs.
ADMIN_PASSWORD_HASH=

# Accounts, password hashes and sessions use the existing DB.
ADMIN_EMAIL=jorgecalvocaminero@gmail.com
# Google OAuth web client. Keep the secret server-side.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Transactional verification/recovery emails only (Resend).
AUTH_MAIL_API_KEY=
AUTH_MAIL_FROM=

# Own accounts use DB sessions regardless of this legacy identity setting.
# Keep disabled for Gmail/Google accounts. Never use AUTH_MODE=sites on Node.
AUTH_MODE=disabled
LOCAL_PREVIEW_AUTH=false
# Required with NODE_ENV=production. No trailing slash.
# PUBLIC_ORIGIN=https://ridecast.example.com
# NODE_ENV=production

# Only on Sites, with its dispatcher as the sole authenticated entry point:
# set the server-side variable AUTH_MODE=sites explicitly.
