# Private server-side value in Sites. Generate locally with scripts/setup-admin.mjs.
ADMIN_PASSWORD_HASH=

# Node standalone: authenticated personal APIs are disabled until a real
# identity provider is integrated. Never use AUTH_MODE=sites on Node.
AUTH_MODE=disabled
LOCAL_PREVIEW_AUTH=false
# Required with NODE_ENV=production. No trailing slash.
# PUBLIC_ORIGIN=https://ridecast.example.com
# NODE_ENV=production

# Only on Sites, with its dispatcher as the sole authenticated entry point:
# set the server-side variable AUTH_MODE=sites explicitly.
